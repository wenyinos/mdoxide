<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>dev.mdoxide.app</id>
  <name>MDOxide</name>
  <summary>A native WYSIWYG markdown editor</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <developer id="dev.mdoxide">
    <name>MDOxide contributors</name>
  </developer>

  <description>
    <p>
      MDOxide is a native WYSIWYG Markdown editor written in Rust with egui.
      No WebView, no Electron, no JavaScript runtime.
    </p>
    <p>Features include:</p>
    <ul>
      <li>WYSIWYG block-level markdown editing</li>
      <li>CommonMark + GitHub Flavored Markdown</li>
      <li>Raw, rendered and split view modes</li>
      <li>Native Mermaid diagram rendering</li>
      <li>HTML and PDF export</li>
      <li>Syntax highlighting and regex find &amp; replace</li>
    </ul>
  </description>

  <launchable type="desktop-id">dev.mdoxide.app.desktop</launchable>

  <url type="homepage">https://github.com/wenyinos/mdoxide</url>
  <url type="bugtracker">https://github.com/wenyinos/mdoxide/issues</url>
  <url type="vcs-browser">https://github.com/wenyinos/mdoxide</url>

  <provides>
    <binary>mdoxide</binary>
  </provides>

  <categories>
    <category>Office</category>
    <category>TextEditor</category>
  </categories>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="0.1.0" date="2026-10-23" type="development">
      <description>
        <p>First development snapshot: Upstream fork, project rename, atomic saves,
        removal of Git integration and Nix support.</p>
      </description>
    </release>
  </releases>
</component>
